            </nav>
            <!-- End of Topbar -->

            <!-- Begin Page Content -->
            <div class="container-fluid">

                <!-- DataTales Example -->
                <div class="card shadow mb-4">
                    <form asp-controller="Admin" asp-action="DeleteMultipleUsers" method="post">
                        <div class="card-header py-3 d-flex justify-content-between ">
                            <h6 class="m-0 font-weight-bold text-primary">Table User</h6>
                            <div>
                                <button class="btn btn-primary btn-sm" type="button" onclick="importUsers()">Import
                                    Users</button>
                                <input type="file" id="importFile" accept=".xlsx" style="display: none;" />
                                <button class="btn btn-success btn-sm" type="button" onclick="exportSelected()">Export
                                    Selected</button>
                                <button class="btn btn-danger btn-sm" type="submit"
                                    onclick="return confirm('Are you sure you want to delete this users?');">Remove</button>
                                <a asp-controller="Admin" asp-action="CreateUserView"
                                    class="btn btn-info btn-sm">ADD</a>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>
                                                <input type="checkbox" id="selectAll" />
                                            </th>
                                            <th>ID</th>
                                            <th>Fullname</th>
                                            <th>Role</th>
                                            <th>Email</th>
                                            <th>Phone number</th>
                                            <th>Address</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tfoot>

                                    </tfoot>
                                    <tbody>
                                        @foreach (var user in Model)
                                        {
                                            <tr>
                                                <td><input type="checkbox" class="rowCheckbox" name="ids"
                                                        value="@user.Id" /></td>
                                                <td>@user.Id</td>
                                                <td>@user.FullName</td>
                                                <td>@user.Role</td>
                                                <td>@user.Email</td>
                                                <td>@user.PhoneNumber</td>
                                                <td>@user.Address</td>
                                                <td>
                                                    <a asp-controller="Admin" asp-action="UpdateUserView"
                                                        asp-route-id="@user.Id" class="btn btn-primary btn-sm">Update</a>
                                                    <a asp-controller="Admin" asp-action="DeleteUser"
                                                        asp-route-id="@user.Id" class="btn btn-danger btn-sm"
                                                        onclick="return confirm('Are you sure you want to delete this user?');">Delete</a>
                                                </td>
                                            </tr>
                                        }
                                        <!-- Thêm các dòng khác tại đây -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
            <!-- /.container-fluid -->

        </div>
        <!-- End of Main Content -->

        <!-- Footer -->
        <footer class="sticky-footer bg-white">
            <div class="container my-auto">
                <div class="copyright text-center my-auto">
                    <span>Copyright &copy; Your Website 2020</span>
                </div>
            </div>
        </footer>
        <!-- End of Footer -->

