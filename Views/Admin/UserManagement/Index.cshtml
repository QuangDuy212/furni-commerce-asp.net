@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
    ViewData["Title"] = "User Management";

}

@model IEnumerable<Furni.ViewModel.UserViewModel>
<!-- Page Wrapper -->
<div id="wrapper">

